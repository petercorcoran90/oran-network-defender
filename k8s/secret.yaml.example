# Copy to secret.yaml, fill in base64-encoded values, and add secret.yaml to .gitignore
apiVersion: v1
kind: Secret
metadata:
  name: oran-defender-secrets
type: Opaque
data:
  DB_USER: <base64-encoded-value>
  DB_PASSWORD: <base64-encoded-value>
  DB_ROOT_PASSWORD: <base64-encoded-value>
  # Shared secret for the simulator's /api/internal ingest calls. The backend reads it as
  # sim.ingest-token (relaxed binding from SIM_INGEST_TOKEN); the simulator sends the same value.
  SIM_INGEST_TOKEN: <base64-encoded-value>
